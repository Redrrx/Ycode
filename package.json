{
  "name": "ycode",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Multi-model coding for Pi.",
  "files": [
    "src/",
    "config.json"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "check": "tsc --noEmit",
    "schema:generate": "node scripts/generate-schema.mjs && prettier --write src/project/schema.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run format:check && npm run lint && npm run check",
    "prepack": "npm run quality",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typebox": "1.3.27",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "@ast-grep/cli": "0.51.1",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "12.8.0",
    "drizzle-orm": "0.45.4",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
